# DingTalk OIDC 网关反向代理参考配置
# authgateway.company.com 为我部署的Authentik，http://127.0.0.1:9011 即为Authentik 实际地址
# 发布模式：https://authgateway.company.com/dingtalk/* 去前缀转发到容器 8000 端口（宿主机映射 9011）
# 与 .env 中 OIDC_ISSUER=https://authgateway.company.com/dingtalk 配套使用
# 端点对照：
#   /dingtalk/.well-known/openid-configuration -> 容器 /.well-known/openid-configuration
#   /dingtalk/oauth|token|userinfo|keys        -> 容器 /oauth|token|userinfo|keys

server {
    listen 80;
    server_name authgateway.company.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name authgateway.company.com;

    ssl_certificate     /etc/nginx/certs/authgateway.company.com.pem;
    ssl_certificate_key /etc/nginx/certs/authgateway.company.com.key;

    # OIDC Discovery：带路径前缀的发现文档转发
    location ^~ /dingtalk/.well-known/ {
        proxy_pass http://127.0.0.1:9011/.well-known/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 业务端点：/dingtalk/xxx 去前缀转发到容器 /xxx
    location ^~ /dingtalk/ {
        proxy_pass http://127.0.0.1:9011/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 其它路径一律 404：网关仅通过 /dingtalk 前缀对外暴露
    location / {
        return 404;
    }
}
